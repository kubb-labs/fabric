{
  "name": "@kubb/stc-fabric",
  "version": "0.8.0",
  "description": "String Template Components (stc) for Kubb, providing signal-based code generation without React dependency.",
  "keywords": [
    "stc",
    "string-template-components",
    "signal",
    "component-generation",
    "typescript",
    "code-generator",
    "codegen",
    "plugins",
    "kubb"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kubb-labs/fabric.git",
    "directory": "packages/stc-fabric"
  },
  "license": "MIT",
  "author": "stijnvanhulle",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    },
    "./plugins": {
      "require": "./dist/plugins.cjs",
      "import": "./dist/plugins.js"
    },
    "./parsers": {
      "require": "./dist/parsers.cjs",
      "import": "./dist/parsers.js"
    },
    "./types": {
      "require": "./dist/types.cjs",
      "import": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "plugins": [
        "./dist/plugins.d.ts"
      ],
      "parsers": [
        "./dist/parsers.d.ts"
      ],
      "types": [
        "./dist/types.d.ts"
      ]
    }
  },
  "files": [
    "src",
    "dist",
    "*.d.ts",
    "*.d.cts",
    "!*.map",
    "!/**/**.test.**",
    "!/**/__tests__/**"
  ],
  "size-limit": [
    {
      "path": "./dist/*.js",
      "limit": "100 KiB",
      "gzip": true
    }
  ],
  "scripts": {
    "build": "tsdown && size-limit",
    "start": "tsdown --watch ./src",
    "clean": "npx rimraf ./dist",
    "lint": "pnpm biome lint .",
    "lint:fix": "pnpm biome lint --fix --unsafe .",
    "release": "pnpm publish --no-git-check",
    "release:canary": "bash ../../.github/canary.sh && node ../../scripts/build.js canary && pnpm publish --no-git-check",
    "test": "vitest --passWithNoTests",
    "typecheck": "tsc -p ./tsconfig.json --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@kubb/fabric-core": "workspace:*",
    "dedent": "^1.7.1",
    "indent-string": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
