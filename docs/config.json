{
  "$schema": "https://kubb.dev/schemas/config/schema.json",
  "sidebars": [
    {
      "name": "default",
      "value": [
        {
          "text": "Menu",
          "items": [
            {
              "text": "Home",
              "link": "/",
              "activeMatch": "^/$"
            },
            {
              "text": "Github",
              "link": "https://github.com/kubb-labs/fabric",
              "target": "_blank"
            },
            {
              "text": "Releases",
              "link": "https://github.com/kubb-labs/fabric/releases",
              "target": "_blank"
            },
            {
              "text": "Changelog",
              "link": "/changelog",
              "activeMatch": "^/changelog/?$"
            }
          ]
        },
        {
          "text": "Getting Started",
          "collapsed": false,
          "items": [
            {
              "text": "Introduction",
              "link": "/getting-started/introduction",
              "activeMatch": "^/getting-started/introduction/?$"
            },
            {
              "text": "Installation",
              "link": "/getting-started/installation",
              "activeMatch": "^/getting-started/installation/?$"
            },
            {
              "text": "Quick Start",
              "link": "/getting-started/quick-start",
              "activeMatch": "^/getting-started/quick-start/?$"
            },
            {
              "text": "Configure",
              "link": "/getting-started/Configure",
              "activeMatch": "^/getting-started/configure/?$"
            },
            {
              "text": "Troubleshooting",
              "link": "/getting-started/troubleshooting",
              "activeMatch": "^/getting-started/troubleshooting/?$"
            }
          ]
        },
        {
          "text": "Core API",
          "collapsed": false,
          "items": [
            {
              "text": "createFabric",
              "link": "/api/core/create-fabric",
              "activeMatch": "^/api/core/create-fabric/?$"
            },
            {
              "text": "Events",
              "link": "/api/core/events",
              "activeMatch": "^/api/core/events/?$"
            }
          ]
        },
        {
          "text": "Plugins",
          "collapsed": false,
          "items": [
            {
              "text": "Fs Plugin",
              "link": "/api/plugins/fs-plugin",
              "activeMatch": "^/api/plugins/fs-plugin/?$"
            },
            {
              "text": "Logger Plugin",
              "link": "/api/plugins/logger-plugin",
              "activeMatch": "^/api/plugins/logger-plugin/?$"
            },
            {
              "text": "Barrel Plugin",
              "link": "/api/plugins/barrel-plugin",
              "activeMatch": "^/api/plugins/barrel-plugin/?$"
            },
            {
              "text": "Graph Plugin",
              "link": "/api/plugins/graph-plugin",
              "activeMatch": "^/api/plugins/graph-plugin/?$"
            },
            {
              "text": "React Plugin",
              "link": "/api/plugins/react-plugin",
              "activeMatch": "^/api/plugins/react-plugin/?$"
            },
            {
              "text": "definePlugin",
              "link": "/api/plugins/define-plugin",
              "activeMatch": "^/api/plugins/define-plugin/?$"
            }
          ]
        },
        {
          "text": "Parsers",
          "collapsed": false,
          "items": [
            {
              "text": "TypeScript Parser",
              "link": "/api/parsers/typescript-parser",
              "activeMatch": "^/api/parsers/typescript-parser/?$"
            },
            {
              "text": "TSX Parser",
              "link": "/api/parsers/tsx-parser",
              "activeMatch": "^/api/parsers/tsx-parser/?$"
            },
            {
              "text": "Default Parser",
              "link": "/api/parsers/default-parser",
              "activeMatch": "^/api/parsers/default-parser/?$"
            },
            {
              "text": "defineParser",
              "link": "/api/parsers/define-parser",
              "activeMatch": "^/api/parsers/define-parser/?$"
            }
          ]
        },
        {
          "text": "Tutorials",
          "collapsed": true,
          "items": [
            {
              "text": "Building a Code Generator",
              "link": "/tutorials/basic",
              "activeMatch": "^/tutorials/basic/?$"
            }
          ]
        }
      ]
    },
    {
      "name": "guide",
      "value": [
        {
          "text": "Creating Plugins",
          "link": "/guide/creating-plugins",
          "activeMatch": "^/guide/creating-plugins/?$"
        },
        {
          "text": "Creating Parsers",
          "link": "/guide/creating-parsers",
          "activeMatch": "^/guide/creating-parsers/?$"
        },
        {
          "text": "File Generation Patterns",
          "link": "/guide/file-generation-patterns",
          "activeMatch": "^/guide/file-generation-patterns/?$"
        }
      ]
    }
  ],
  "sidebar": {
    "/getting-started": "default",
    "/api": "default",
    "/tutorials": "default",
    "/guide": "guide"
  }
}
